<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Kod engine: a local sidecar the desktop shell spawns. Roslyn (MSBuildWorkspace) for C# intelligence,
       the dotnet CLI for build / run / test, a WebSocket hub for live events. -->
  <PropertyGroup>
    <AssemblyName>Kod.Engine</AssemblyName>
    <RootNamespace>Kod.Engine</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <NoWarn>$(NoWarn);RS1035;RS1036</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- compact the heap (large objects included) when it gets fragmented, instead of growing it -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Porta.Pty" Version="2.2.3" />
    <!-- Microsoft.Data.SqlClient brings a vulnerable 9.0.x Pkcs: pin the patched one -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
