{
  "name": "kod-desktop",
  "productName": "Kod",
  "version": "0.1.0",
  "description": "Kod: a focused C# and .NET IDE",
  "author": "Kod contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main.js",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node build/bundle.mjs",
    "build": "npm run typecheck && npm run bundle",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "dev.kod.ide",
    "productName": "Kod",
    "directories": { "output": "dist" },
    "files": ["out/**", "package.json"],
    "extraResources": [
      { "from": "../ui/dist", "to": "ui" },
      { "from": "../engine/publish", "to": "engine" }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" },
    "linux": { "target": ["AppImage"], "category": "Development" }
  }
}
